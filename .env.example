ARKOS_HTTP_PORT=8080
ARKOS_API_PORT=5000
FLASK_SECRET_KEY=change-me-secret-key
ADMIN_PASSWORD=arkosadmin
BRIDGE_TOKEN=change-me-bridge-token
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
MINECRAFT_COMMAND_WRAPPER=
CLOUDFLARE_TUNNEL_TOKEN=

# --- Base de données ---
# En local (Docker/SQLite) laisse vide. En production (Vercel + Supabase),
# mets l'URL de connexion PostgreSQL fournie par Supabase.
DATABASE_URL=

# Commande de récompense de vote par défaut (le {player} est remplacé par le pseudo).
VOTE_REWARD_COMMAND=ar vote {player} 250

# --- Supabase (si tu utilises Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PostgreSQL local (docker-compose profile "postgres") ---
POSTGRES_DB=arkos
POSTGRES_USER=arkos
POSTGRES_PASSWORD=arkos-change-me
